<file path="src/app/tryon/TryOnPage.tsx">
import React, { useState, useRef } from "react";
import { useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import {
  Sparkles,
  Camera,
  Upload,
  RotateCcw,
  Sliders,
  Scissors,
  Check,
  Palette,
  Layers,
  Calendar,
} from "lucide-react";
import Button from "@/components/ui/Button";
import Card from "@/components/ui/Card";

export const TryOnPage: React.FC = () => {
  const navigate = useNavigate();
  const { user } = useAuth();
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const styles = [
    { id: "1", name: "Textured Crop", category: "Short", img: "/assets/images/style1.png", suitability: "Oval & Square Faces" },
    { id: "2", name: "Curly Taper Fade", category: "Curly", img: "/assets/images/style2.png", suitability: "Angular & Oval Faces" },
    { id: "3", name: "Classic Side Part", category: "Medium", img: "/assets/images/style3.png", suitability: "Round & Heart Faces" },
    { id: "4", name: "Military Buzz Cut", category: "Short", img: "/assets/images/style4.png", suitability: "Strong Jawline & Oval" },
    { id: "5", name: "Modern Pompadour", category: "Voluminous", img: "/assets/images/style5.png", suitability: "Square & Oblong Faces" },
    { id: "6", name: "Undercut Quiff", category: "Medium", img: "/assets/images/style6.png", suitability: "Diamond & Triangle Faces" },
  ];

  const colors = [
    { name: "Natural Jet Black", hex: "#111113" },
    { name: "Espresso Dark Brown", hex: "#2b1e18" },
    { name: "Chestnut Brown", hex: "#4a3224" },
    { name: "Honey Amber", hex: "#b47c34" },
    { name: "Platinum Silver", hex: "#c4c5cc" },
  ];

  const [selectedStyle, setSelectedStyle] = useState(styles[0]);
  const [selectedColor, setSelectedColor] = useState(colors[0]);
  const [customPhoto, setCustomPhoto] = useState<string | null>(null);
  const [hairScale, setHairScale] = useState(100);
  const [hairOffsetY, setHairOffsetY] = useState(0);

  const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => setCustomPhoto(reader.result as string);
    reader.readAsDataURL(file);
  };

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border pb-6">
        <div>
          <div className="flex items-center gap-2 text-primary text-xs font-black uppercase tracking-wider mb-1">
            <Sparkles size={14} className="fill-primary" />
            Virtual Studio
          </div>
          <h1 className="text-3xl font-black text-white tracking-tight">AI Virtual Hairstyle Try-On</h1>
          <p className="text-xs text-textSecondary mt-1">
            Test trending haircuts and color tones on your facial geometry before stepping into the barber chair
          </p>
        </div>

        <div className="flex items-center gap-3">
          <Button
            variant="outline"
            size="sm"
            onClick={() => navigate("/scanner")}
            icon={<Camera size={14} />}
          >
            New Face Scan
          </Button>
          <Button
            variant="primary"
            size="sm"
            onClick={() => navigate("/booking")}
            icon={<Calendar size={14} />}
          >
            Book This Cut
          </Button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* ================= LEFT COLUMN: Virtual Try-On Canvas ================= */}
        <div className="lg:col-span-7 space-y-6">
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black uppercase text-primary tracking-wider">
                Virtual Mirror Canvas
              </span>
              <span className="text-xs text-textMuted font-bold">
                Style: <span className="text-white">{selectedStyle.name}</span>
              </span>
            </div>

            {/* The Try-On Viewport */}
            <div className="relative aspect-[4/5] max-w-md mx-auto rounded-3xl overflow-hidden bg-black border-2 border-primary/40 shadow-2xl flex items-center justify-center">
              {/* Base Face Image */}
              <img
                src={customPhoto || "/assets/images/hero.png"}
                alt="Base Face"
                className="w-full h-full object-cover"
              />

              {/* Dynamic Hair Simulation Overlay */}
              <div
                className="absolute inset-0 pointer-events-none transition-all duration-200"
                style={{
                  transform: `translateY(${hairOffsetY}px) scale(${hairScale / 100})`,
                }}
              >
                <img
                  src={selectedStyle.img}
                  alt={selectedStyle.name}
                  className="w-full h-full object-cover mix-blend-screen opacity-90 filter"
                  style={{
                    filter: `drop-shadow(0 0 15px rgba(0,0,0,0.8))`,
                  }}
                />
              </div>

              {/* Canvas Overlays & Badges */}
              <div className="absolute bottom-4 left-4 right-4 p-3.5 rounded-2xl bg-surface/85 backdrop-blur-md border border-border flex items-center justify-between">
                <div>
                  <span className="text-[10px] font-black uppercase tracking-wider text-primary">
                    Selected Simulation
                  </span>
                  <h4 className="text-sm font-black text-white">{selectedStyle.name}</h4>
                  <p className="text-[10px] text-textMuted">{selectedStyle.suitability}</p>
                </div>
                <div
                  className="w-6 h-6 rounded-full border border-white/40 shadow-md"
                  style={{ backgroundColor: selectedColor.hex }}
                  title={selectedColor.name}
                />
              </div>
            </div>

            {/* Canvas Adjustment Sliders */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-border">
              <div className="space-y-1.5">
                <div className="flex justify-between text-xs text-textMuted">
                  <span>Proportion Scale</span>
                  <span className="font-mono text-white">{hairScale}%</span>
                </div>
                <input
                  type="range"
                  min="80"
                  max="120"
                  value={hairScale}
                  onChange={(e) => setHairScale(Number(e.target.value))}
                  className="w-full accent-primary bg-surfaceDark rounded-lg h-2 cursor-pointer"
                />
              </div>

              <div className="space-y-1.5">
                <div className="flex justify-between text-xs text-textMuted">
                  <span>Vertical Position</span>
                  <span className="font-mono text-white">{hairOffsetY}px</span>
                </div>
                <input
                  type="range"
                  min="-30"
                  max="30"
                  value={hairOffsetY}
                  onChange={(e) => setHairOffsetY(Number(e.target.value))}
                  className="w-full accent-primary bg-surfaceDark rounded-lg h-2 cursor-pointer"
                />
              </div>
            </div>

            <div className="flex items-center justify-between pt-2">
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                onChange={handlePhotoUpload}
                className="hidden"
              />
              <Button
                variant="secondary"
                size="sm"
                onClick={() => fileInputRef.current?.click()}
                icon={<Upload size={14} />}
              >
                Upload Your Own Photo
              </Button>

              <Button
                variant="ghost"
                size="sm"
                onClick={() => {
                  setCustomPhoto(null);
                  setHairScale(100);
                  setHairOffsetY(0);
                }}
                icon={<RotateCcw size={14} />}
              >
                Reset Canvas
              </Button>
            </div>
          </Card>
        </div>

        {/* ================= RIGHT COLUMN: Hairstyle & Color Controls ================= */}
        <div className="lg:col-span-5 space-y-6">
          {/* Hair Color Palette Selector */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-xs font-black uppercase tracking-wider text-primary flex items-center gap-2">
                <Palette size={14} /> Color Tint Tuning
              </h3>
              <span className="text-xs font-bold text-white">{selectedColor.name}</span>
            </div>

            <div className="flex items-center gap-3">
              {colors.map((c) => {
                const isSelected = selectedColor.name === c.name;
                return (
                  <button
                    key={c.name}
                    onClick={() => setSelectedColor(c)}
                    className={`relative w-10 h-10 rounded-2xl border-2 transition-all flex items-center justify-center ${
                      isSelected
                        ? "border-primary scale-110 shadow-lg shadow-amber-500/30"
                        : "border-border hover:scale-105"
                    }`}
                    style={{ backgroundColor: c.hex }}
                    title={c.name}
                  >
                    {isSelected && <Check size={16} className="text-white drop-shadow-md" />}
                  </button>
                );
              })}
            </div>
          </Card>

          {/* Hairstyle Model Catalog */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <h3 className="text-xs font-black uppercase tracking-wider text-primary flex items-center gap-2">
              <Scissors size={14} /> Select Hairstyle Model
            </h3>

            <div className="grid grid-cols-2 gap-3 max-h-[460px] overflow-y-auto pr-1">
              {styles.map((s) => {
                const isSelected = selectedStyle.id === s.id;
                return (
                  <div
                    key={s.id}
                    onClick={() => setSelectedStyle(s)}
                    className={`rounded-2xl border-2 overflow-hidden cursor-pointer transition-all bg-surfaceDark ${
                      isSelected
                        ? "border-primary shadow-lg shadow-amber-500/20"
                        : "border-border hover:border-borderLight"
                    }`}
                  >
                    <div className="relative aspect-square w-full overflow-hidden bg-black">
                      <img src={s.img} alt={s.name} className="w-full h-full object-cover" />
                      {isSelected && (
                        <div className="absolute top-2 right-2 bg-primary rounded-full p-1 text-black">
                          <Check size={12} />
                        </div>
                      )}
                    </div>
                    <div className="p-2.5">
                      <h4 className={`text-xs font-black ${isSelected ? "text-primary" : "text-white"} truncate`}>
                        {s.name}
                      </h4>
                      <p className="text-[10px] text-textMuted mt-0.5">{s.category}</p>
                    </div>
                  </div>
                );
              })}
            </div>

            <Button
              variant="primary"
              size="lg"
              className="w-full font-black text-sm"
              onClick={() => navigate("/booking")}
              icon={<Calendar size={16} />}
            >
              SCHEDULE WITH THIS CUT
            </Button>
          </Card>
        </div>
      </div>
    </div>
  );
};

export default TryOnPage;
