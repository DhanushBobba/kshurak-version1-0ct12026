import React from "react";
import { useNavigate, useLocation } from "react-router-dom";
import { generatePDF } from "@/utils/pdfGenerator";
import { supabase } from "@/lib/supabase";
import {
  Download,
  Sparkles,
  ArrowRight,
  ShieldCheck,
  CheckCircle2,
  Cpu,
  Layers,
  BarChart3,
  Flame,
} from "lucide-react";
import Button from "@/components/ui/Button";
import Card from "@/components/ui/Card";

export const GeometryPage: React.FC = () => {
  const navigate = useNavigate();
  const location = useLocation();

  // Retrieve state passed from scanner, with fallback defaults if visited directly
  const stateImages = location.state?.images;
  const stateData = location.state?.data;

  const images = stateImages || {
    front: "/assets/images/style1.png",
    left: "/assets/images/style2.png",
    right: "/assets/images/style3.png",
  };

  const result = stateData || {
    faceShape: "Oval",
    symmetryScore: "94%",
    aiAccuracy: "96.5%",
    faceLength: "186mm",
    faceWidth: "138mm",
    faceRatio: "1.35",
    foreheadWidth: "132mm",
    foreheadHeight: "62mm",
    cheekboneWidth: "140mm",
    jawWidth: "118mm",
    jawAngle: "122°",
    jawlineShape: "Defined Angular",
    faceSymmetry: "94%",
  };

  const cleanNumber = (value: any) => {
    if (!value) return 0;
    return Number(
      String(value)
        .replace("mm", "")
        .replace("%", "")
        .replace("°", "")
        .trim()
    );
  };

  const metrics = [
    { title: "Face Length", value: result?.faceLength || "186mm" },
    { title: "Face Width", value: result?.faceWidth || "138mm" },
    { title: "Face Ratio (L/W)", value: result?.faceRatio || "1.35" },
    { title: "Forehead Width", value: result?.foreheadWidth || "132mm" },
    { title: "Forehead Height", value: result?.foreheadHeight || "62mm" },
    { title: "Cheekbone Width", value: result?.cheekboneWidth || "140mm" },
    { title: "Jaw Width", value: result?.jawWidth || "118mm" },
    { title: "Jaw Angle", value: result?.jawAngle || "122°" },
    { title: "Jawline Shape", value: result?.jawlineShape || "Defined Angular" },
    { title: "Face Symmetry", value: result?.faceSymmetry || "94%" },
  ];

  const saveGeometryReport = async () => {
    try {
      const { data: userData } = await supabase.auth.getUser();
      const user = userData?.user;
      if (!user) return;

      const { data: profile } = await supabase
        .from("profiles")
        .select("id")
        .eq("auth_user_id", user.id)
        .maybeSingle();

      if (!profile) return;

      const { data: scan } = await supabase
        .from("face_scans")
        .select("id")
        .eq("profile_id", profile.id)
        .order("scanned_at", { ascending: false })
        .limit(1)
        .maybeSingle();

      if (!scan) return;

      await supabase.from("geometry_reports").insert({
        face_scan_id: scan.id,
        face_length: cleanNumber(result?.faceLength),
        face_width: cleanNumber(result?.faceWidth),
        face_ratio: cleanNumber(result?.faceRatio),
        forehead_width: cleanNumber(result?.foreheadWidth),
        forehead_height: cleanNumber(result?.foreheadHeight),
        cheekbone_width: cleanNumber(result?.cheekboneWidth),
        jaw_width: cleanNumber(result?.jawWidth),
        jaw_angle: cleanNumber(result?.jawAngle),
        jawline_shape: result?.jawlineShape || "",
        face_symmetry: cleanNumber(result?.faceSymmetry),
        face_shape: result?.faceShape || "",
        symmetry_score: cleanNumber(result?.symmetryScore),
        ai_accuracy: cleanNumber(result?.aiAccuracy),
        created_at: new Date().toISOString(),
      });
    } catch (err) {
      console.error("Geometry report save error", err);
    }
  };

  const handleDownload = async () => {
    try {
      await saveGeometryReport();
      await generatePDF({
        image: images?.front,
        faceShape: result?.faceShape || "N/A",
        symmetry: result?.faceSymmetry || "N/A",
        metrics: metrics,
        style: "AI Recommended Style: Textured Crop & Low Fade",
      });
    } catch (err: any) {
      alert("Unable to generate PDF: " + (err.message || "Unknown error"));
    }
  };

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
      {/* Top Banner */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border pb-6">
        <div>
          <div className="flex items-center gap-2 text-primary text-xs font-black uppercase tracking-wider mb-1">
            <CheckCircle2 size={16} className="text-primary" />
            Analysis Verified
          </div>
          <h1 className="text-3xl font-black text-white tracking-tight">AI Facial Geometry Report</h1>
          <p className="text-xs text-textSecondary mt-1">
            Computed from 3-point biometric orientation vectors & proportion algorithms
          </p>
        </div>

        <div className="flex items-center gap-3">
          <Button
            variant="outline"
            size="md"
            onClick={handleDownload}
            icon={<Download size={16} />}
          >
            Download PDF Report
          </Button>
          <Button
            variant="primary"
            size="md"
            onClick={() => navigate("/tryon")}
            icon={<Sparkles size={16} />}
          >
            Try AI Hairstyle
          </Button>
        </div>
      </div>

      {/* Grid Layout: Left Visuals & Profile, Right Detailed Metrics */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* ================= LEFT COLUMN: Visuals & Profile Summary ================= */}
        <div className="lg:col-span-6 space-y-6">
          {/* Face Scan Viewpoints Card */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black uppercase tracking-wider text-primary">
                Multi-View Biometric Capture
              </span>
              <span className="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-black text-emerald-400">
                ✓ SCAN COMPLETED
              </span>
            </div>

            <div className="grid grid-cols-3 gap-3">
              <div className="space-y-1.5 text-center">
                <div className="relative aspect-[3/4] rounded-2xl overflow-hidden bg-surfaceDark border border-border">
                  <img src={images.front} alt="Front View" className="w-full h-full object-cover" />
                  <span className="absolute bottom-1.5 left-1.5 right-1.5 py-0.5 rounded bg-black/80 backdrop-blur-sm text-[9px] font-black text-primary">
                    FRONT 0°
                  </span>
                </div>
              </div>

              <div className="space-y-1.5 text-center">
                <div className="relative aspect-[3/4] rounded-2xl overflow-hidden bg-surfaceDark border border-border">
                  <img src={images.left} alt="Left View" className="w-full h-full object-cover" />
                  <span className="absolute bottom-1.5 left-1.5 right-1.5 py-0.5 rounded bg-black/80 backdrop-blur-sm text-[9px] font-black text-primary">
                    LEFT 45°
                  </span>
                </div>
              </div>

              <div className="space-y-1.5 text-center">
                <div className="relative aspect-[3/4] rounded-2xl overflow-hidden bg-surfaceDark border border-border">
                  <img src={images.right} alt="Right View" className="w-full h-full object-cover" />
                  <span className="absolute bottom-1.5 left-1.5 right-1.5 py-0.5 rounded bg-black/80 backdrop-blur-sm text-[9px] font-black text-primary">
                    RIGHT 45°
                  </span>
                </div>
              </div>
            </div>
          </Card>

          {/* Face Profile Metrics Summary Card */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-black text-primary uppercase tracking-wider">
                Face Profile Summary
              </h3>
              <Cpu size={16} className="text-textMuted" />
            </div>

            <div className="grid grid-cols-3 gap-3">
              <div className="p-3.5 bg-surfaceDark rounded-xl border border-border text-center">
                <span className="text-[10px] text-textMuted font-bold uppercase block">Shape</span>
                <span className="text-base font-black text-white mt-1 block">
                  {result?.faceShape || "Oval"}
                </span>
              </div>

              <div className="p-3.5 bg-surfaceDark rounded-xl border border-border text-center">
                <span className="text-[10px] text-textMuted font-bold uppercase block">Symmetry</span>
                <span className="text-base font-black text-primary mt-1 block">
                  {result?.symmetryScore || result?.faceSymmetry || "94%"}
                </span>
              </div>

              <div className="p-3.5 bg-surfaceDark rounded-xl border border-border text-center">
                <span className="text-[10px] text-textMuted font-bold uppercase block">Confidence</span>
                <span className="text-base font-black text-emerald-400 mt-1 block">
                  {result?.aiAccuracy || "96.5%"}
                </span>
              </div>
            </div>
          </Card>

          {/* AI Hairstyle Match Recommendation Card */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center gap-2">
              <Flame size={18} className="text-primary fill-primary" />
              <h3 className="text-sm font-black text-white uppercase tracking-wider">
                AI Hairstyle Match Recommendation
              </h3>
            </div>

            <div className="p-4 bg-surfaceDark rounded-2xl border border-border space-y-3">
