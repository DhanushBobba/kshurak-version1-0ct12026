                    ? "border-primary/60 border-dashed"
                    : "border-border"
                }`}
              >
                {images.front ? (
                  <>
                    <img src={images.front} alt="Front View" className="w-full h-full object-cover" />
                    <div className="absolute top-2 right-2 bg-black/80 rounded-full p-1 text-primary">
                      <CheckCircle size={14} />
