import React, { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { Shield, Eye, EyeOff, Lock, Mail, Sparkles, User, Scissors } from "lucide-react";
import Button from "@/components/ui/Button";
import Input from "@/components/ui/Input";

export const LoginPage: React.FC = () => {
  const navigate = useNavigate();
  const { login, googleLogin, facebookLogin } = useAuth();
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [userRole, setUserRole] = useState<"user" | "barber">("user");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!email || !password) {
      setError("Please fill in both email and password.");
      return;
    }

    try {
      setLoading(true);
      setError(null);
      await login(email, password);
      navigate("/");
    } catch (err: any) {
      console.error(err);
      setError(err.message || "Login failed. Please check your credentials.");
    } finally {
      setLoading(false);
    }
  };

  const handleGoogle = async () => {
    try {
      setError(null);
      await googleLogin();
    } catch (err: any) {
      setError(err.message || "Google authentication failed.");
    }
  };

  const handleFacebook = async () => {
    try {
      setError(null);
      await facebookLogin();
    } catch (err: any) {
      setError(err.message || "Facebook authentication failed.");
    }
  };

  return (
    <div className="min-h-[85vh] flex items-center justify-center px-4 py-12">
      <div className="w-full max-w-md space-y-8">
        {/* Brand Header */}
        <div className="text-center space-y-3">
          <div className="w-20 h-20 mx-auto rounded-3xl bg-surface border border-primary/40 p-3 shadow-2xl shadow-amber-500/10 flex items-center justify-center">
            <img
              src="/assets/images/logo.png"
              alt="Kshurak Logo"
              className="w-full h-full object-contain"
              onError={(e) => {
                (e.target as HTMLElement).style.display = "none";
              }}
            />
          </div>
          <h1 className="text-3xl font-black text-white tracking-tight">Welcome Back</h1>
          <p className="text-xs text-textSecondary">
            Sign in to access your AI facial geometry & hairstyle records
          </p>
        </div>

        {/* Auth Card */}
        <div className="bg-surface border border-border rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
          {/* User vs Barber Tab Switcher */}
          <div className="grid grid-cols-2 p-1 bg-surfaceDark rounded-2xl border border-border">
            <button
              type="button"
              onClick={() => setUserRole("user")}
              className={`flex items-center justify-center gap-2 py-2.5 rounded-xl text-xs font-black transition-all ${
                userRole === "user"
                  ? "bg-surfaceLight text-primary border border-primary/30 shadow-md"
                  : "text-textMuted hover:text-white"
              }`}
            >
              <User size={15} />
              User Login
            </button>
            <button
              type="button"
              onClick={() => setUserRole("barber")}
              className={`flex items-center justify-center gap-2 py-2.5 rounded-xl text-xs font-black transition-all ${
                userRole === "barber"
                  ? "bg-surfaceLight text-primary border border-primary/30 shadow-md"
                  : "text-textMuted hover:text-white"
              }`}
            >
              <Scissors size={15} />
              Barber Login
            </button>
          </div>

          {error && (
            <div className="p-3.5 rounded-xl bg-error/10 border border-error/30 text-error text-xs font-bold leading-relaxed">
              {error}
            </div>
          )}

          <form onSubmit={handleLogin} className="space-y-4">
            <Input
              label="Email Address"
              type="email"
              placeholder="you@domain.com"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              icon={<Mail size={18} />}
              required
            />

            <Input
              label="Password"
              type={showPassword ? "text" : "password"}
              placeholder="••••••••"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              icon={<Lock size={18} />}
              rightElement={
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="text-textMuted hover:text-white p-1"
                >
                  {showPassword ? <EyeOff size={18} /> : <Eye size={18} />}
                </button>
              }
              required
            />

            <Button
              type="submit"
              variant="primary"
              size="lg"
              className="w-full text-base font-black mt-2"
              loading={loading}
              icon={<Sparkles size={16} />}
            >
              VERIFY & LOGIN
            </Button>
          </form>

          {/* Social Logins */}
          <div className="space-y-3 pt-2">
            <div className="relative flex items-center justify-center">
              <div className="border-t border-border w-full" />
              <span className="bg-surface px-3 text-[11px] font-bold text-textMuted uppercase tracking-wider absolute">
                Or Continue With
              </span>
            </div>

            <div className="grid grid-cols-2 gap-3 pt-2">
              <button
                type="button"
                onClick={handleGoogle}
                className="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-surfaceDark hover:bg-surfaceLight border border-border text-white text-xs font-bold transition-all"
              >
                <span>🌐</span> Google
              </button>
              <button
                type="button"
                onClick={handleFacebook}
                className="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-surfaceDark hover:bg-surfaceLight border border-border text-white text-xs font-bold transition-all"
              >
                <span className="text-blue-500 font-bold">f</span> Facebook
              </button>
            </div>
          </div>
        </div>

        {/* Security Footnote */}
        <div className="flex items-center justify-center gap-3 text-center text-xs text-textMuted">
          <Shield size={20} className="text-primary shrink-0" />
          <span>Your biometric data is encrypted with enterprise-grade SSL protection.</span>
        </div>

        {/* Signup Redirect */}
        <div className="text-center text-xs text-textSecondary">
          Don't have an account?{" "}
          <Link to="/auth/signup" className="text-primary font-black hover:underline">
            Create Account
          </Link>
        </div>
      </div>
    </div>
  );
};

export default LoginPage;
</file>

<file path="src/app/auth/SignupPage.tsx">
import React, { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { User, Mail, Lock, Sparkles, ChevronDown, Check } from "lucide-react";
import Button from "@/components/ui/Button";
import Input from "@/components/ui/Input";

export const SignupPage: React.FC = () => {
  const navigate = useNavigate();
  const { signup } = useAuth();
  const [form, setForm] = useState({
    username: "",
    age: "",
    gender: "",
    email: "",
    password: "",
    confirmPassword: "",
  });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const update = (key: keyof typeof form, value: string) => {
    setForm((prev) => ({ ...prev, [key]: value }));
  };

  const handleSignup = async (e: React.FormEvent) => {
    e.preventDefault();

    if (
      !form.username ||
      !form.age ||
      !form.gender ||
      !form.email ||
      !form.password ||
      !form.confirmPassword
    ) {
      setError("Please complete all required fields.");
      return;
    }

    if (form.password !== form.confirmPassword) {
      setError("Passwords do not match.");
      return;
    }

    if (form.password.length < 6) {
      setError("Password should be at least 6 characters.");
      return;
    }

    try {
      setLoading(true);
      setError(null);
      await signup({
        username: form.username,
        age: form.age,
        gender: form.gender,
        email: form.email,
        password: form.password,
      });
      navigate("/");
    } catch (err: any) {
      console.error(err);
      setError(err.message || "Failed to create account. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-[85vh] flex items-center justify-center px-4 py-12">
      <div className="w-full max-w-lg space-y-8">
        {/* Brand Header */}
        <div className="text-center space-y-3">
          <div className="w-20 h-20 mx-auto rounded-3xl bg-surface border border-primary/40 p-3 shadow-2xl shadow-amber-500/10 flex items-center justify-center">
            <img
              src="/assets/images/logo.png"
              alt="Kshurak Logo"
              className="w-full h-full object-contain"
              onError={(e) => {
                (e.target as HTMLElement).style.display = "none";
              }}
            />
          </div>
          <h1 className="text-3xl font-black text-white tracking-tight">Create Account</h1>
          <p className="text-xs text-textSecondary">
            Set up your biometric hair profile to unlock AI face scanning & tailored barber blueprints
          </p>
        </div>

        {/* Card */}
        <div className="bg-surface border border-border rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
          {error && (
            <div className="p-3.5 rounded-xl bg-error/10 border border-error/30 text-error text-xs font-bold leading-relaxed">
              {error}
            </div>
          )}

          <form onSubmit={handleSignup} className="space-y-4">
            <Input
              label="Full Name / Username"
              type="text"
              placeholder="e.g. Alex Morgan"
              value={form.username}
              onChange={(e) => update("username", e.target.value)}
              icon={<User size={18} />}
              required
            />

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input
                label="Age"
                type="number"
                placeholder="e.g. 26"
                value={form.age}
                onChange={(e) => update("age", e.target.value)}
                min="5"
                max="120"
                required
              />

              <div className="space-y-1.5 text-left">
                <label className="block text-xs font-black tracking-wider text-primary uppercase">
                  Gender
                </label>
                <div className="relative">
                  <select
                    value={form.gender}
                    onChange={(e) => update("gender", e.target.value)}
                    className="w-full bg-surfaceDark text-white border border-border rounded-2xl px-4 py-3.5 text-sm appearance-none focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 cursor-pointer"
                    required
                  >
                    <option value="" disabled className="bg-surfaceDark text-textMuted">
                      Select Gender
                    </option>
                    <option value="Male" className="bg-surfaceDark text-white">
                      Male
                    </option>
                    <option value="Female" className="bg-surfaceDark text-white">
                      Female
                    </option>
                    <option value="Others" className="bg-surfaceDark text-white">
                      Others
                    </option>
                  </select>
                  <ChevronDown
                    size={16}
                    className="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-textMuted"
                  />
                </div>
              </div>
            </div>

            <Input
              label="Email Address"
              type="email"
              placeholder="name@domain.com"
              value={form.email}
              onChange={(e) => update("email", e.target.value)}
              icon={<Mail size={18} />}
              required
            />

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input
                label="Password"
                type="password"
                placeholder="••••••••"
                value={form.password}
                onChange={(e) => update("password", e.target.value)}
                icon={<Lock size={18} />}
                required
              />

              <Input
                label="Confirm Password"
                type="password"
                placeholder="••••••••"
                value={form.confirmPassword}
                onChange={(e) => update("confirmPassword", e.target.value)}
                icon={<Lock size={18} />}
                required
              />
            </div>

            <Button
              type="submit"
              variant="primary"
              size="lg"
              className="w-full text-base font-black mt-4"
              loading={loading}
              icon={<Sparkles size={16} />}
            >
              COMPLETE REGISTRATION
            </Button>
          </form>
        </div>

        <div className="text-center text-xs text-textSecondary">
          Already have an account?{" "}
          <Link to="/auth/login" className="text-primary font-black hover:underline">
            Login
          </Link>
        </div>
      </div>
    </div>
  );
};

export default SignupPage;
</file>

