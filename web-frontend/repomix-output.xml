                </span>
                <span className="text-primary group-hover:translate-x-1 transition-transform">→</span>
              </Link>
            </div>
          </Card>
        </div>

        {/* ================= RIGHT COLUMN: Primary + Family Profiles Management ================= */}
        <div className="lg:col-span-8 space-y-6">
          {/* Active Profile Status Header */}
          <Card variant="surface" className="p-6 border-border space-y-4">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-base font-black text-white">Primary Account</h3>
                <p className="text-xs text-textSecondary mt-0.5">
                  The default master account for billing and authentication
                </p>
              </div>
              <span className="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-black text-emerald-400">
