    capturePhoto,
  } = useCamera();

  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const [step, setStep] = useState<1 | 2 | 3>(1);
  const [sideStep, setSideStep] = useState<"left" | "right">("left");
  const [images, setImages] = useState<{
    front: string | null;
    left: string | null;
    right: string | null;
  }>({
    front: null,
    left: null,
    right: null,
  });

  const [loading, setLoading] = useState(false);
  const [analysisProgress, setAnalysisProgress] = useState<string>("");
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // Automatically request camera on mount
  useEffect(() => {
    startCamera();
    return () => {
      stopCamera();
    };
  }, []);

  const cleanNumber = (value: any) => {
    if (!value) return 0;
    return Number(
      String(value)
        .replace("mm", "")
        .replace("%", "")
        .replace("°", "")
        .trim()
    );
  };

  const handleCapture = () => {
    const photoDataUrl = capturePhoto();
    if (!photoDataUrl) {
      setErrorMessage("Unable to capture from camera. Ensure camera is active.");
      return;
    }
    applyCapturedImage(photoDataUrl);
  };

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const dataUrl = await readFileAsDataURL(file);
      applyCapturedImage(dataUrl);
    } catch (err) {
      console.error(err);
      setErrorMessage("Failed to read image file.");
    }
  };

  const applyCapturedImage = (dataUrl: string) => {
    setErrorMessage(null);
    if (step === 1) {
      setImages((prev) => ({ ...prev, front: dataUrl }));
      setStep(2);
      setSideStep("left");
    } else if (step === 2) {
      if (sideStep === "left") {
        setImages((prev) => ({ ...prev, left: dataUrl }));
        setSideStep("right");
      } else {
        setImages((prev) => ({ ...prev, right: dataUrl }));
        setStep(3);
      }
    }
  };

  const resetScan = () => {
    setImages({ front: null, left: null, right: null });
    setStep(1);
    setSideStep("left");
    setErrorMessage(null);
  };

  const startScan = async () => {
    if (!images.front || !images.left || !images.right) {
      setErrorMessage("Please capture all 3 views: Front, Left Profile, and Right Profile.");
      return;
    }

    try {
      setLoading(true);
      setErrorMessage(null);
      setAnalysisProgress("Encoding high-resolution face coordinates...");

      const frontBase64 = await convertImageToBase64(images.front);
      const leftBase64 = await convertImageToBase64(images.left);
      const rightBase64 = await convertImageToBase64(images.right);

      setAnalysisProgress("Sending to Gemini 2.0 Biometric Vision Model...");
      const result: FaceAnalysisResult = await analyzeFace({
        front: frontBase64,
        left: leftBase64,
        right: rightBase64,
      });

      setAnalysisProgress("Authenticating profile records...");
      const { data: userData } = await supabase.auth.getUser();
      const currentUser = userData?.user || user;

      if (!currentUser) {
        throw new Error("User session expired. Please log in again.");
      }

      setAnalysisProgress("Uploading biometric scan records to cloud storage...");
      const frontURL = await uploadFaceImage(images.front, currentUser.id, "front");
      const leftURL = await uploadFaceImage(images.left, currentUser.id, "left");
      const rightURL = await uploadFaceImage(images.right, currentUser.id, "right");

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("id")
        .eq("auth_user_id", currentUser.id)
        .maybeSingle();

      if (profileError || !profile) {
        throw new Error("User profile not found. Please setup profile.");
      }

      setAnalysisProgress("Persisting facial geometry and metric vectors...");
      const { data: scan, error: scanError } = await supabase
        .from("face_scans")
        .insert({
          profile_id: profile.id,
          front_image_url: frontURL,
          left_image_url: leftURL,
          right_image_url: rightURL,
          face_shape: result.faceShape || "Unknown",
          symmetry_score: cleanNumber(result.faceSymmetry),
          ai_accuracy: cleanNumber(result.aiAccuracy),
          scanned_at: new Date().toISOString(),
        })
        .select()
        .single();

      if (scanError) throw scanError;

      if (scan) {
        await supabase.from("face_metrics").insert({
          scan_id: scan.id,
          face_length: cleanNumber(result.faceLength),
          face_width: cleanNumber(result.faceWidth),
          face_ratio: cleanNumber(result.faceRatio),
          forehead_width: cleanNumber(result.foreheadWidth),
          forehead_height: cleanNumber(result.foreheadHeight),
          cheekbone_width: cleanNumber(result.cheekboneWidth),
          jaw_width: cleanNumber(result.jawWidth),
          jaw_angle: cleanNumber(result.jawAngle),
          jawline_shape: result.jawlineShape || "",
          face_symmetry: cleanNumber(result.faceSymmetry),
        });

        await supabase.from("profile_history").insert({
          profile_id: profile.id,
          activity_type: "FACE_SCAN",
          title: "AI Face Geometry Completed",
          description: "Front, left and right face analysis completed",
          activity_date: new Date().toISOString(),
        });
      }

      setAnalysisProgress("Geometry analysis complete! Opening report...");
      // Stop camera before route change
      stopCamera();

      navigate("/geometry", {
        state: {
          images: {
            front: frontURL,
            left: leftURL,
            right: rightURL,
          },
          data: result,
        },
      });
    } catch (err: any) {
      console.error("Scan error", err);
      setErrorMessage(err.message || "Unable to analyse face. Please verify images and try again.");
    } finally {
      setLoading(false);
      setAnalysisProgress("");
    }
  };

  const currentStepTitle =
    step === 1
      ? "Front Face Capture"
      : step === 2
      ? sideStep === "left"
        ? "Left Profile Capture (Turn head 45° left)"
        : "Right Profile Capture (Turn head 45° right)"
      : "All 3 Angles Ready for Geometry Processing";

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
      {/* Top Banner */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
        <div>
          <div className="flex items-center gap-2 text-primary text-xs font-black uppercase tracking-wider mb-1">
            <Sparkles size={14} className="fill-primary" />
            Computer Vision Module
          </div>
          <h1 className="text-3xl font-black text-white tracking-tight">AI Face Geometry Scanner</h1>
          <p className="text-xs text-textSecondary mt-1">
            Capture three biometric viewpoints for accurate millimetric skull and symmetry modeling
          </p>
        </div>

        <div className="flex items-center gap-3">
          <Button
            variant="ghost"
            size="sm"
            onClick={resetScan}
            icon={<RotateCcw size={15} />}
          >
            Reset All
          </Button>
          <div className="px-3.5 py-1.5 rounded-full bg-surface border border-border text-xs font-bold text-white flex items-center gap-2">
            <span className="w-2 h-2 rounded-full bg-primary animate-pulse" />
            Step {step} of 3
          </div>
        </div>
      </div>

      {errorMessage && (
        <div className="p-4 rounded-2xl bg-error/10 border border-error/30 text-error text-xs font-bold flex items-center gap-3">
          <AlertCircle size={18} className="shrink-0" />
          <span>{errorMessage}</span>
        </div>
      )}

      {/* Main Desktop 2-Column Layout */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* ================= LEFT COLUMN: Camera & Viewfinder ================= */}
        <div className="lg:col-span-7 space-y-4">
          <Card variant="surface" className="p-4 sm:p-6 overflow-hidden relative border-border">
            {/* Viewfinder Header */}
            <div className="flex items-center justify-between mb-4">
              <div className="flex items-center gap-2">
                <span className="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping" />
                <span className="text-xs font-black uppercase text-white tracking-wide">
                  Live Biometric Feed
                </span>
              </div>
              <div className="text-xs text-primary font-bold">
                {step === 1 ? "ANGLE: 0° FRONT" : step === 2 ? `ANGLE: ${sideStep.toUpperCase()} 45°` : "CAPTURE COMPLETE"}
              </div>
            </div>

            {/* Video Viewfinder Box */}
            <div className="relative aspect-[4/3] w-full rounded-2xl overflow-hidden bg-black border-2 border-border flex items-center justify-center shadow-inner">
              <video
                ref={videoRef}
                autoPlay
                playsInline
                muted
                className="w-full h-full object-cover transform -scale-x-100"
              />

              {/* Facial Guide Oval Overlay */}
              <div className="absolute inset-0 pointer-events-none flex items-center justify-center">
                <div
                  className={`w-64 h-80 rounded-[48%] border-2 border-dashed transition-all duration-300 ${
                    step === 3
                      ? "border-emerald-500 bg-emerald-500/10"
                      : "border-primary/60 bg-primary/5"
                  } flex flex-col items-center justify-between py-6`}
                >
                  <div className="text-[10px] uppercase font-black tracking-widest text-primary/80 bg-black/60 px-3 py-1 rounded-full">
                    {step === 1
                      ? "Align Face in Center"
                      : step === 2
                      ? `Turn Face to ${sideStep.toUpperCase()}`
                      : "Aligned"}
                  </div>
                  <div className="w-12 h-12 border-t-2 border-b-2 border-primary/40 rounded-full" />
                  <div className="text-[10px] uppercase font-bold text-textMuted bg-black/60 px-3 py-0.5 rounded-full">
                    Jawline Indicator
                  </div>
                </div>
              </div>

              {/* Camera State Fallback */}
              {!isStreaming && (
                <div className="absolute inset-0 bg-surfaceDark/90 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center space-y-3 z-10">
                  <VideoOff size={40} className="text-textMuted" />
                  <div>
                    <h4 className="text-sm font-black text-white">Camera Access Inactive</h4>
                    <p className="text-xs text-textSecondary max-w-xs mt-1">
                      {cameraError || "Please allow camera access or use the manual image upload button."}
                    </p>
                  </div>
                  <Button size="sm" variant="outline" onClick={startCamera}>
                    Re-enable Camera
                  </Button>
                </div>
              )}

              {/* Viewpoint Badge */}
              <div className="absolute top-4 left-4 px-3 py-1 rounded-xl bg-black/70 backdrop-blur-md border border-white/10 text-xs font-black text-primary">
                {step === 1 ? "1. FRONT VIEW" : step === 2 ? `2. ${sideStep.toUpperCase()} PROFILE` : "3. COMPLETE"}
              </div>
