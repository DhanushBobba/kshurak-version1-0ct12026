                    ? "border-primary/60 border-dashed"
                    : "border-border"
                }`}
              >
                {images.right ? (
                  <>
                    <img src={images.right} alt="Right View" className="w-full h-full object-cover" />
                    <div className="absolute top-2 right-2 bg-black/80 rounded-full p-1 text-primary">
                      <CheckCircle size={14} />
                    </div>
                  </>
                ) : (
                  <div className="space-y-1">
                    <Camera size={22} className="mx-auto text-textMuted" />
                    <span className="text-[11px] font-bold text-textMuted block">Right 45°</span>
                  </div>
                )}
                <span className="absolute bottom-2 left-2 right-2 py-0.5 rounded bg-black/80 backdrop-blur-sm text-[9px] font-black text-primary uppercase">
                  Right 45°
                </span>
              </div>
            </div>

            {/* Checklist */}
            <div className="space-y-2 pt-2 border-t border-border">
              <div className="flex items-center justify-between text-xs">
                <span className="text-textSecondary flex items-center gap-2">
                  <CheckCircle size={14} className={images.front ? "text-primary" : "text-border"} />
                  Frontal symmetry baseline
                </span>
                <span className="font-bold text-white">{images.front ? "Ready" : "Pending"}</span>
              </div>
              <div className="flex items-center justify-between text-xs">
                <span className="text-textSecondary flex items-center gap-2">
                  <CheckCircle size={14} className={images.left ? "text-primary" : "text-border"} />
                  Left temporal & jaw angle
                </span>
                <span className="font-bold text-white">{images.left ? "Ready" : "Pending"}</span>
              </div>
              <div className="flex items-center justify-between text-xs">
                <span className="text-textSecondary flex items-center gap-2">
                  <CheckCircle size={14} className={images.right ? "text-primary" : "text-border"} />
                  Right temporal & crown curve
                </span>
                <span className="font-bold text-white">{images.right ? "Ready" : "Pending"}</span>
              </div>
            </div>

            {/* Primary Analysis Trigger CTA */}
            <div className="pt-4 space-y-3">
              <Button
                variant="primary"
                size="lg"
                onClick={startScan}
                loading={loading}
                disabled={!images.front || !images.left || !images.right}
                icon={<Sparkles size={18} />}
                className="w-full text-base font-black py-4 shadow-xl shadow-amber-500/20"
              >
                {loading ? "PROCESSING BIOMETRICS..." : "SCAN & CALCULATE GEOMETRY"}
              </Button>

              {loading && analysisProgress && (
                <div className="p-3 rounded-xl bg-surfaceDark border border-primary/30 text-center animate-pulse">
                  <p className="text-xs text-primary font-bold">{analysisProgress}</p>
                </div>
              )}

              <p className="text-[11px] text-textMuted text-center">
                Analyzes facial thirds, cheekbone width, jawline taper, and golden ratio proportions.
              </p>
            </div>
          </Card>

          {/* Biometrics Engine Specs */}
          <Card variant="dark" className="p-5 border-border space-y-3">
            <div className="flex items-center gap-2 text-primary font-bold text-xs">
              <ShieldCheck size={16} />
              <span>Biometric Accuracy Standards</span>
            </div>
            <p className="text-xs text-textSecondary leading-relaxed">
              Our neural network estimates cranial width, forehead height, and mandibular angle down to standard millimetric tolerances without needing specialized LiDAR hardware.
            </p>
          </Card>
        </div>
      </div>
    </div>
  );
};

export default ScannerPage;
