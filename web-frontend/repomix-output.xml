                className="font-black px-8 text-sm"
              >
                {step === 1
                  ? "CAPTURE FRONT"
                  : step === 2
                  ? sideStep === "left"
                    ? "CAPTURE LEFT"
                    : "CAPTURE RIGHT"
                  : "ALL CAPTURED"}
              </Button>
            </div>
          </Card>

          {/* Quick Capture Guide */}
          <div className="p-4 rounded-2xl bg-surfaceDark border border-border flex items-start gap-3.5">
            <HelpCircle size={20} className="text-primary shrink-0 mt-0.5" />
