import { supabase } from "@/lib/supabase";

export const uploadFaceImage = async (
  uriOrFile: string | File | Blob,
  userId: string,
  angle: string
): Promise<string> => {
  try {
    let blob: Blob;

    if (uriOrFile instanceof Blob) {
      blob = uriOrFile;
    } else if (typeof uriOrFile === "string") {
      const response = await fetch(uriOrFile);
      blob = await response.blob();
    } else {
      blob = uriOrFile;
    }

    const filePath = `${userId}/${Date.now()}_${angle}.jpg`;

    const { error } = await supabase.storage
      .from("face-scans")
      .upload(filePath, blob, {
        contentType: "image/jpeg",
        upsert: true,
      });

    if (error) {
      console.warn("Face scan upload error, using local data URL fallback", error);
      // Fallback: If Supabase bucket doesn't exist or isn't public, return the source data URL
      if (typeof uriOrFile === "string") return uriOrFile;
      return URL.createObjectURL(blob);
    }

    const { data } = supabase.storage
      .from("face-scans")
      .getPublicUrl(filePath);

    return data.publicUrl;
  } catch (error) {
    console.error("Upload error", error);
    if (typeof uriOrFile === "string") return uriOrFile;
    throw error;
  }
};

export const uploadProfileImage = async (
  uriOrFile: string | File | Blob,
  userId: string,
  prefix: string = "profile"
): Promise<string> => {
  try {
    let blob: Blob;

    if (uriOrFile instanceof Blob) {
      blob = uriOrFile;
    } else if (typeof uriOrFile === "string") {
      const response = await fetch(uriOrFile);
      blob = await response.blob();
    } else {
      blob = uriOrFile;
    }

    const fileName = `${userId}/${prefix}_${Date.now()}.jpg`;

    const { error } = await supabase.storage
      .from("profile-images")
      .upload(fileName, blob, {
        contentType: "image/jpeg",
        upsert: true,
      });

    if (error) {
      console.warn("Profile image storage error, returning local preview", error);
      if (typeof uriOrFile === "string") return uriOrFile;
      return URL.createObjectURL(blob);
    }

    const { data } = supabase.storage
      .from("profile-images")
      .getPublicUrl(fileName);

    return data.publicUrl;
  } catch (error) {
    console.error("Image upload error", error);
    if (typeof uriOrFile === "string") return uriOrFile;
    throw error;
  }
};
