import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { supabase } from "@/lib/supabase";
import { ArrowLeft, User, Mail, Phone, Calendar, Image, Save, Check } from "lucide-react";
import Button from "@/components/ui/Button";
import Input from "@/components/ui/Input";
import Card from "@/components/ui/Card";

export const EditProfilePage: React.FC = () => {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [profileId, setProfileId] = useState("");
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");
  const [age, setAge] = useState("");
  const [gender, setGender] = useState("");
  const [image, setImage] = useState("");
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    loadProfile();
  }, [user]);

  const loadProfile = async () => {
    try {
      if (!user) return;
      const { data, error } = await supabase
        .from("profiles")
        .select("*")
        .eq("auth_user_id", user.id)
        .single();

      if (error) throw error;

      setProfileId(data.id);
      setName(data.full_name || "");
      setEmail(data.email || "");
      setPhone(data.phone || "");
      setAge(data.age ? String(data.age) : "");
      setGender(data.gender || "");
      setImage(data.profile_image || data.profile_image_url || "");
    } catch (err: any) {
      console.error(err);
      setError("Unable to load profile data.");
    } finally {
      setLoading(false);
    }
  };

  const handleUpdate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!profileId) return;

    try {
      setSaving(true);
      setError(null);

      const { error: updateError } = await supabase
        .from("profiles")
        .update({
          full_name: name,
          email: email,
          phone: phone,
          age: age ? Number(age) : null,
          gender: gender,
          profile_image: image,
          profile_image_url: image,
          updated_at: new Date().toISOString(),
        })
        .eq("id", profileId);

      if (updateError) throw updateError;

      alert("Profile updated successfully!");
      navigate("/profile");
    } catch (err: any) {
      console.error(err);
      setError(err.message || "Failed to update profile.");
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-[70vh] flex flex-col items-center justify-center space-y-3">
        <div className="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin" />
        <p className="text-xs text-primary font-bold">Loading Account Information...</p>
      </div>
    );
  }

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto space-y-6">
      <div className="flex items-center justify-between border-b border-border pb-6">
        <div>
          <button
            onClick={() => navigate("/profile")}
            className="flex items-center gap-1.5 text-xs text-textMuted hover:text-white mb-2"
          >
            <ArrowLeft size={14} /> Back to Profile
          </button>
          <h1 className="text-3xl font-black text-white tracking-tight">Edit Profile</h1>
          <p className="text-xs text-textSecondary mt-1">
            Update personal contact credentials and biometric parameters
          </p>
        </div>
      </div>

      {error && (
        <div className="p-4 rounded-2xl bg-error/10 border border-error/30 text-error text-xs font-bold">
          {error}
        </div>
      )}

      <Card variant="surface" className="p-6 sm:p-8 border-border">
        <form onSubmit={handleUpdate} className="space-y-4">
          <Input
            label="Full Name"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="Enter full name"
            icon={<User size={18} />}
            required
          />

          <Input
            label="Email Address"
            type="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            placeholder="Enter email address"
            icon={<Mail size={18} />}
            required
          />

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              label="Phone Number"
              type="tel"
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              placeholder="+1 (555) 000-0000"
              icon={<Phone size={18} />}
            />

            <Input
              label="Age"
              type="number"
              value={age}
              onChange={(e) => setAge(e.target.value)}
              placeholder="e.g. 28"
            />
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              label="Gender"
              value={gender}
              onChange={(e) => setGender(e.target.value)}
              placeholder="Male / Female / Other"
            />

            <Input
              label="Profile Image URL"
              value={image}
              onChange={(e) => setImage(e.target.value)}
              placeholder="https://domain.com/photo.jpg"
              icon={<Image size={18} />}
            />
          </div>

          <div className="pt-6 border-t border-border flex items-center justify-end gap-3">
            <Button
              type="button"
              variant="secondary"
              size="md"
              onClick={() => navigate("/profile")}
            >
              Cancel
            </Button>
            <Button
              type="submit"
              variant="primary"
              size="md"
              loading={saving}
              icon={<Save size={16} />}
              className="px-8 font-black"
            >
              Save Profile
            </Button>
          </div>
        </form>
      </Card>
    </div>
  );
};

export default EditProfilePage;
