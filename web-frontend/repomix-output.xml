                  {primaryProfile.name.charAt(0)}
                </div>
                <div>
                  <h4 className="text-sm font-black text-white">{primaryProfile.name}</h4>
                  <p className="text-xs text-textSecondary">{primaryProfile.email}</p>
                </div>
              </div>

              <Button
                variant={activeProfileId === primaryProfile.id ? "primary" : "outline"}
                size="sm"
                onClick={() => handleSwitch(primaryProfile.id, "PRIMARY")}
