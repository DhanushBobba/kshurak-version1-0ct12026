<file path="src/app/survey/SurveyPage.tsx">
import React, { useState } from "react";
import { useNavigate } from "react-router-dom";
import { supabase } from "@/lib/supabase";
import { useAuth } from "@/context/AuthContext";
import {
  ClipboardList,
  Sparkles,
  ChevronRight,
  ChevronLeft,
  CheckCircle,
  HelpCircle,
  Shield,
  Layers,
  ArrowRight,
} from "lucide-react";
import Button from "@/components/ui/Button";
import Card from "@/components/ui/Card";

type SurveyData = {
  hair_texture: string;
  density: string;
  growth_length: string;
  silhouette: string;
  maintenance: string;
  scalp_profile: string;
};

export const SurveyPage: React.FC = () => {
  const navigate = useNavigate();
  const { user } = useAuth();
  const [step, setStep] = useState<number>(1);
  const [saving, setSaving] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  const [data, setData] = useState<SurveyData>({
    hair_texture: "Straight",
    density: "Medium",
    growth_length: "Short",
    silhouette: "Modern",
    maintenance: "Medium",
    scalp_profile: "Resilient",
  });

  const updateValue = (field: keyof SurveyData, value: string) => {
    setData((prev) => ({ ...prev, [field]: value }));
  };

  const getProfile = async () => {
    try {
      if (!user?.id) return null;

      const { data: profile } = await supabase
        .from("profiles")
        .select("id")
        .eq("auth_user_id", user.id)
        .maybeSingle();

      if (profile) return profile;

      const { data: emailProfile } = await supabase
        .from("profiles")
        .select("id")
        .eq("email", user.email)
        .maybeSingle();

      return emailProfile;
    } catch (err) {
      console.error("Profile fetch error", err);
      return null;
    }
  };

  const saveSurveyHistory = async (profileId: string) => {
    try {
      await supabase.from("profile_history").insert({
        profile_id: profileId,
        activity_type: "SURVEY",
        title: "AI Hair Survey Completed",
        description: `Hair Texture: ${data.hair_texture}, Density: ${data.density}, Length: ${data.growth_length}, Style: ${data.silhouette}, Maintenance: ${data.maintenance}, Scalp: ${data.scalp_profile}`,
        activity_date: new Date().toISOString(),
      });
    } catch (err) {
      console.error("Survey history error", err);
    }
  };

  const saveSurvey = async () => {
    try {
      if (!user?.id) {
        alert("Please login to save your survey.");
        navigate("/auth/login");
        return;
      }

      setSaving(true);
      setErrorMessage(null);

      const profile = await getProfile();
      if (!profile) {
        throw new Error("User profile not found. Please setup profile.");
      }

      const { error } = await supabase.from("user_surveys").insert({
        user_id: user.id,
        profile_id: profile.id,
        hair_texture: data.hair_texture,
        density: data.density,
        growth_length: data.growth_length,
        silhouette: data.silhouette,
        maintenance: data.maintenance,
        scalp_profile: data.scalp_profile,
      });

      if (error) throw error;

      await saveSurveyHistory(profile.id);

      // Successfully saved survey, navigate to scanner as in mobile app
      navigate("/scanner");
    } catch (err: any) {
      console.error("Survey Error", err);
      setErrorMessage(err.message || "Unable to save survey. Please try again.");
    } finally {
      setSaving(false);
    }
  };

  const handleNext = () => {
    if (step < 5) {
      setStep((prev) => prev + 1);
    } else {
      saveSurvey();
    }
  };

  const handleBack = () => {
    if (step > 1) {
      setStep((prev) => prev - 1);
    }
  };

  const stepMeta = [
    { number: 1, title: "Texture", subtitle: "Natural follicle strand form" },
    { number: 2, title: "Density", subtitle: "Follicle thickness & volume" },
    { number: 3, title: "Length", subtitle: "Current strand measurements" },
    { number: 4, title: "Preference", subtitle: "Target hairstyle aesthetic" },
    { number: 5, title: "Scalp Profile", subtitle: "Dermis sensitivity & oiliness" },
  ];

  const renderOptions = () => {
    switch (step) {
      case 1:
        return [
          { value: "Straight", title: "Straight (Type 1)", desc: "Smooth strands with minimal wave or curl pattern", icon: "〰" },
          { value: "Wavy", title: "Wavy (Type 2)", desc: "S-shaped curves, prone to subtle volume and body", icon: "〰" },
          { value: "Curly", title: "Curly (Type 3)", desc: "Defined spirals and loops with natural bounce", icon: "〰" },
          { value: "Coily", title: "Coily / Kinky (Type 4)", desc: "Tight zigzag curls or compact coils needing high moisture", icon: "〰" },
        ].map((opt) => (
          <OptionCard
            key={opt.value}
            selected={data.hair_texture === opt.value}
            onClick={() => updateValue("hair_texture", opt.value)}
            title={opt.title}
            desc={opt.desc}
            icon={opt.icon}
          />
        ));

      case 2:
        return [
          { value: "Low", title: "Low Density (Thin)", desc: "Scalp easily visible, lighter styling products recommended", icon: "●" },
          { value: "Medium", title: "Medium Density (Normal)", desc: "Balanced coverage and versatile styling flexibility", icon: "●" },
          { value: "High", title: "High Density (Thick)", desc: "Abundant follicle growth, holds heavy structured cuts", icon: "●" },
        ].map((opt) => (
          <OptionCard
            key={opt.value}
            selected={data.density === opt.value}
            onClick={() => updateValue("density", opt.value)}
            title={opt.title}
            desc={opt.desc}
            icon={opt.icon}
          />
        ));

      case 3:
        return [
          { value: "Short", title: "Short (< 2 inches)", desc: "Crops, buzzes, fades, and tapered styles", icon: "✂" },
          { value: "Medium", title: "Medium (2 - 5 inches)", desc: "Quiffs, side parts, pompadours, and textured fringes", icon: "✂" },
          { value: "Long", title: "Long (> 5 inches)", desc: "Flowing styles, man buns, and shoulder-length cuts", icon: "✂" },
        ].map((opt) => (
          <OptionCard
            key={opt.value}
            selected={data.growth_length === opt.value}
            onClick={() => updateValue("growth_length", opt.value)}
            title={opt.title}
            desc={opt.desc}
            icon={opt.icon}
          />
        ));

      case 4:
        return [
          { value: "Classic", title: "Classic Gentleman", desc: "Timeless side-part, low taper, comb-over, executive clean cut", icon: "★" },
          { value: "Modern", title: "Modern Precision", desc: "Textured crop, drop fade, burst fade, clean geometric edges", icon: "★" },
          { value: "Trendy", title: "Bold & Avant-Garde", desc: "Mullet fade, wolf cut, dyed accent textured curls", icon: "★" },
        ].map((opt) => (
          <OptionCard
            key={opt.value}
            selected={data.silhouette === opt.value}
            onClick={() => updateValue("silhouette", opt.value)}
            title={opt.title}
            desc={opt.desc}
            icon={opt.icon}
          />
        ));

      case 5:
        return [
          { value: "Resilient", title: "Resilient / Normal", desc: "Healthy dermis with no redness, itching, or product sensitivity", icon: "✓" },
          { value: "Sensitive", title: "Sensitive / Dry", desc: "Prone to irritation, razor burn, or flake accumulation", icon: "⚠" },
          { value: "Oily", title: "Oily / Active", desc: "Excess sebum production, benefits from clarifying lightweight washes", icon: "◉" },
        ].map((opt) => (
          <OptionCard
            key={opt.value}
            selected={data.scalp_profile === opt.value}
            onClick={() => updateValue("scalp_profile", opt.value)}
            title={opt.title}
            desc={opt.desc}
            icon={opt.icon}
          />
        ));

      default:
        return null;
    }
  };

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-8">
      {/* Header */}
      <div className="text-center space-y-2">
        <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-xs font-black uppercase">
          <ClipboardList size={14} />
          Diagnostic Module
        </div>
        <h1 className="text-3xl sm:text-4xl font-black text-white tracking-tight">
          AI Hair & Scalp Profile
        </h1>
        <p className="text-xs sm:text-sm text-textSecondary max-w-lg mx-auto">
          5-question diagnostic calibrating the AI geometry engine to your follicle biology and aesthetic preferences.
        </p>
      </div>

      {errorMessage && (
        <div className="p-4 rounded-2xl bg-error/10 border border-error/30 text-error text-xs font-bold text-center">
          {errorMessage}
        </div>
      )}

      {/* Progress Stepper Bar */}
      <div className="bg-surface border border-border rounded-2xl p-4">
        <div className="flex items-center justify-between text-xs font-bold text-textMuted mb-2 px-1">
          <span className="text-primary font-black uppercase tracking-wider">
            Step {step} of 5: {stepMeta[step - 1].title}
          </span>
          <span className="font-mono text-white">{step * 20}% Completed</span>
        </div>
        <div className="w-full h-2 rounded-full bg-surfaceDark overflow-hidden border border-border">
          <div
            className="h-full bg-gradient-to-r from-amber-500 to-primary transition-all duration-300"
            style={{ width: `${step * 20}%` }}
          />
        </div>

        {/* Step indicators */}
        <div className="hidden sm:grid grid-cols-5 gap-2 mt-4 pt-3 border-t border-border">
          {stepMeta.map((s) => (
            <div
              key={s.number}
              onClick={() => s.number < step && setStep(s.number)}
              className={`p-2 rounded-xl text-left transition-all ${
                s.number === step
                  ? "bg-primary/10 border border-primary/30"
                  : s.number < step
                  ? "text-white cursor-pointer hover:bg-surfaceLight"
                  : "opacity-40"
              }`}
            >
              <div className="text-[10px] font-black uppercase text-primary">
                0{s.number}. {s.title}
              </div>
              <div className="text-[11px] text-textMuted truncate">{s.subtitle}</div>
            </div>
          ))}
        </div>
      </div>

      {/* Question Card */}
      <Card variant="surface" className="p-6 sm:p-8 border-border space-y-6">
        <div>
          <h2 className="text-xl sm:text-2xl font-black text-white">
            {step === 1 && "What is your natural hair texture?"}
            {step === 2 && "How would you describe your hair density?"}
            {step === 3 && "What is your current hair length?"}
            {step === 4 && "What overall style preference do you gravitate toward?"}
            {step === 5 && "How would you describe your scalp condition?"}
          </h2>
          <p className="text-xs text-textSecondary mt-1">
            {stepMeta[step - 1].subtitle}
          </p>
        </div>

        {/* Options Stack */}
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {renderOptions()}
        </div>

        {/* Navigation Buttons */}
        <div className="flex items-center justify-between pt-6 border-t border-border gap-4">
          <Button
            variant="secondary"
            size="lg"
            onClick={handleBack}
            disabled={step === 1 || saving}
            icon={<ChevronLeft size={18} />}
          >
            Back
          </Button>

          <Button
            variant="primary"
            size="lg"
            onClick={handleNext}
            loading={saving}
            icon={step === 5 ? <Sparkles size={18} /> : <ChevronRight size={18} />}
            className="px-8 font-black"
          >
            {step === 5 ? "COMPLETE & PROCEED TO SCANNER" : "NEXT STEP"}
          </Button>
        </div>
      </Card>
    </div>
  );
};

interface OptionCardProps {
  selected: boolean;
  onClick: () => void;
  title: string;
  desc: string;
  icon: string;
}

const OptionCard: React.FC<OptionCardProps> = ({
  selected,
  onClick,
  title,
  desc,
  icon,
}) => {
  return (
    <div
      onClick={onClick}
      className={`p-4 rounded-2xl border-2 transition-all cursor-pointer flex items-start gap-4 select-none ${
        selected
          ? "bg-surfaceLight border-primary shadow-lg shadow-amber-500/10"
          : "bg-surfaceDark border-border hover:border-borderLight hover:bg-surface"
      }`}
    >
      <div
        className={`w-10 h-10 rounded-xl flex items-center justify-center text-lg font-black shrink-0 ${
          selected
            ? "bg-primary text-black"
            : "bg-surface border border-border text-textMuted"
        }`}
      >
        {icon}
      </div>

      <div className="flex-1 space-y-1">
        <div className="flex items-center justify-between">
          <h4 className={`text-sm font-black ${selected ? "text-primary" : "text-white"}`}>
            {title}
          </h4>
          <div
            className={`w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 ${
              selected ? "border-primary bg-primary" : "border-border"
            }`}
          >
            {selected && <div className="w-2 h-2 rounded-full bg-black" />}
          </div>
        </div>
        <p className="text-xs text-textSecondary leading-relaxed">{desc}</p>
      </div>
    </div>
  );
};

export default SurveyPage;
