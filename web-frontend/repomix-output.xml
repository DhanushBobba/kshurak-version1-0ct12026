                  Left 45°
                </span>
              </div>

              {/* Right Profile Slot */}
              <div
                className={`relative aspect-[3/4] rounded-2xl overflow-hidden border-2 transition-all bg-surfaceDark flex flex-col items-center justify-center p-2 text-center ${
                  images.right
