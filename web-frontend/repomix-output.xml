<file path="src/app/profile/HistoryPage.tsx">
import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { supabase } from "@/lib/supabase";
import {
  History as HistoryIcon,
  ArrowLeft,
  Download,
  Calendar,
  Sparkles,
  ClipboardList,
  Layers,
  Clock,
  ShieldCheck,
} from "lucide-react";
import Button from "@/components/ui/Button";
import Card from "@/components/ui/Card";

type HistoryItem = {
  id: string;
  activity_type: string;
  title: string;
  description: string | null;
  activity_date: string;
};

export const HistoryPage: React.FC = () => {
  const navigate = useNavigate();
  const { user } = useAuth();
  const [history, setHistory] = useState<HistoryItem[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadHistory();
  }, [user]);

  const loadHistory = async () => {
    try {
      if (!user) {
        setLoading(false);
        return;
      }

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("id")
        .eq("auth_user_id", user.id)
        .single();

      if (profileError || !profile) {
        setLoading(false);
        return;
      }

      const { data, error } = await supabase
        .from("profile_history")
        .select("*")
        .eq("profile_id", profile.id)
        .order("activity_date", { ascending: false });

      if (error) throw error;
      setHistory(data || []);
    } catch (err) {
      console.error("History Error", err);
    } finally {
      setLoading(false);
    }
  };

  const formatDate = (date: string) => {
    try {
      return new Date(date).toLocaleString();
    } catch {
      return "";
    }
  };

  const downloadPDF = () => {
    const html = `
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Kshurak Profile History</title>
<style>
body { background: #070708; color: #FFFFFF; font-family: Arial, sans-serif; padding: 30px; max-width: 800px; margin: 0 auto; }
h1 { color: #F59E0B; text-align: center; }
.card { background: #17181A; padding: 15px; margin-top: 15px; border-radius: 12px; border: 1px solid #27282C; }
h3 { color: #F59E0B; margin: 0 0 6px 0; }
p { color: #9E9EA7; font-size: 13px; line-height: 18px; margin: 4px 0; }
.date { color: #F59E0B; font-size: 11px; font-weight: bold; }
</style>
</head>
<body>
<h1>KSHURAK PROFILE HISTORY</h1>
<p style="text-align: center; color: #71717A;">Generated on ${new Date().toLocaleDateString()}</p>
${history
  .map(
    (item) => `
<div class="card">
  <h3>${item.title}</h3>
  <p>${item.description || "No details available"}</p>
  <p class="date">${formatDate(item.activity_date)}</p>
</div>
`
  )
  .join("")}
<script>
window.onload = function() { window.print(); };
</script>
</body>
</html>
`;

    const printWin = window.open("", "_blank");
    if (printWin) {
      printWin.document.open();
      printWin.document.write(html);
      printWin.document.close();
    }
  };

  if (loading) {
    return (
      <div className="min-h-[70vh] flex flex-col items-center justify-center space-y-3">
        <div className="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin" />
        <p className="text-xs text-primary font-bold">Retrieving Activity Logs...</p>
      </div>
    );
  }

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-8">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
        <div>
          <button
            onClick={() => navigate("/profile")}
            className="flex items-center gap-1.5 text-xs text-textMuted hover:text-white mb-2"
          >
            <ArrowLeft size={14} /> Back to Profile
          </button>
          <h1 className="text-3xl font-black text-white tracking-tight">Activity & Scan History</h1>
          <p className="text-xs text-textSecondary mt-1">
            Complete timeline of your biometric face scans, hair surveys, and geometry reports
          </p>
        </div>

        <div>
          <Button
            variant="outline"
            size="md"
            onClick={downloadPDF}
            disabled={history.length === 0}
            icon={<Download size={16} />}
          >
            Download History PDF
          </Button>
        </div>
      </div>

      {/* History Timeline */}
      {history.length === 0 ? (
        <Card variant="surface" className="p-12 text-center border-dashed border-border space-y-3">
          <div className="w-14 h-14 rounded-2xl bg-surfaceDark border border-border mx-auto flex items-center justify-center text-textMuted">
            <HistoryIcon size={28} />
          </div>
          <h3 className="text-base font-black text-white">No Activity Records Found</h3>
          <p className="text-xs text-textSecondary max-w-sm mx-auto">
            You haven't run any face scans or completed surveys yet. Start your first scan to generate an activity log.
          </p>
          <div className="pt-2">
            <Button
              variant="primary"
              size="sm"
              onClick={() => navigate("/scanner")}
              icon={<Sparkles size={14} />}
            >
              Start Face Scan
            </Button>
          </div>
        </Card>
      ) : (
        <div className="space-y-4">
          {history.map((item) => {
            const isScan = item.activity_type === "FACE_SCAN";
            const isSurvey = item.activity_type === "SURVEY";

            return (
              <Card
                key={item.id}
                variant="surface"
                className="p-5 border-border hover:border-borderLight transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
              >
                <div className="flex items-start sm:items-center gap-4">
                  <div
                    className={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-xs shrink-0 ${
                      isScan
                        ? "bg-primary text-black shadow-md shadow-amber-500/20"
                        : isSurvey
                        ? "bg-surfaceLight border border-primary text-primary"
                        : "bg-surfaceDark border border-border text-white"
                    }`}
                  >
                    {isScan ? "AI" : isSurvey ? "SV" : "GR"}
                  </div>

                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <h4 className="text-sm font-black text-white">{item.title}</h4>
                      <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-surfaceDark text-primary border border-border uppercase">
                        {item.activity_type}
                      </span>
                    </div>
                    <p className="text-xs text-textSecondary leading-relaxed">
                      {item.description || "Facial geometric analysis processed."}
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-1.5 text-[11px] font-mono font-bold text-textMuted shrink-0">
                  <Clock size={13} className="text-primary" />
                  <span>{formatDate(item.activity_date)}</span>
                </div>
              </Card>
            );
          })}
        </div>
      )}
    </div>
  );
};

export default HistoryPage;
</file>

