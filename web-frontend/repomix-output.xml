<file path="src/app/profile/AddChildPage.tsx">
import React, { useEffect, useState, useRef } from "react";
import { useNavigate } from "react-router-dom";
import { useAuth } from "@/context/AuthContext";
import { supabase } from "@/lib/supabase";
import { uploadProfileImage } from "@/services/storageService";
import { readFileAsDataURL } from "@/utils/imageConverter";
import {
  UserPlus,
  User,
  Mail,
  Phone,
  Calendar,
  Camera,
  ArrowLeft,
  Sparkles,
  ChevronDown,
} from "lucide-react";
import Button from "@/components/ui/Button";
import Input from "@/components/ui/Input";
import Card from "@/components/ui/Card";

export const AddChildPage: React.FC = () => {
  const navigate = useNavigate();
  const { user } = useAuth();
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const [parentId, setParentId] = useState("");
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");
  const [age, setAge] = useState("");
  const [gender, setGender] = useState("");
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [imageFile, setImageFile] = useState<File | null>(null);

  const [loading, setLoading] = useState(true);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    getParentProfile();
  }, [user]);

  const getParentProfile = async () => {
    try {
      if (!user) return;
      const { data, error } = await supabase
        .from("profiles")
        .select("id")
        .eq("auth_user_id", user.id)
        .single();

      if (error) throw error;
      setParentId(data.id);
    } catch (err: any) {
      console.error(err);
      setError("Unable to find parent profile. Please setup master profile first.");
    } finally {
      setLoading(false);
    }
  };

  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const dataUrl = await readFileAsDataURL(file);
      setImagePreview(dataUrl);
      setImageFile(file);
    } catch (err) {
      console.error(err);
    }
  };

  const handleAddChild = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!parentId) {
      setError("Parent profile is required.");
      return;
    }

    if (!name || !age || !gender) {
      setError("Please fill in child's name, age, and gender.");
      return;
    }

    try {
      setUploading(true);
      setError(null);

      let imageUrl: string | null = null;
      if (imageFile && user) {
        imageUrl = await uploadProfileImage(imageFile, user.id, "child");
      }

      const { error: insertError } = await supabase.from("child_profiles").insert({
        parent_profile_id: parentId,
        full_name: name,
        email: email || null,
        phone: phone || null,
        age: Number(age),
        gender: gender,
        profile_image_url: imageUrl,
      });

      if (insertError) throw insertError;

      alert("Child profile added successfully!");
      navigate("/profile");
    } catch (err: any) {
      console.error(err);
      setError(err.message || "Failed to add child profile.");
    } finally {
      setUploading(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-[70vh] flex flex-col items-center justify-center space-y-3">
        <div className="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin" />
        <p className="text-xs text-primary font-bold">Verifying Account...</p>
      </div>
    );
  }

  return (
    <div className="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between border-b border-border pb-6">
        <div>
          <button
            onClick={() => navigate("/profile")}
            className="flex items-center gap-1.5 text-xs text-textMuted hover:text-white mb-2"
          >
            <ArrowLeft size={14} /> Back to Profiles
          </button>
          <h1 className="text-3xl font-black text-white tracking-tight">Add Child Profile</h1>
          <p className="text-xs text-textSecondary mt-1">
            Create an independent facial geometry and styling profile under your parent account
          </p>
        </div>
      </div>

      {error && (
        <div className="p-4 rounded-2xl bg-error/10 border border-error/30 text-error text-xs font-bold">
          {error}
        </div>
      )}

      <Card variant="surface" className="p-6 sm:p-8 border-border">
        <form onSubmit={handleAddChild} className="space-y-6">
          {/* Avatar Selector */}
          <div className="flex flex-col items-center justify-center text-center space-y-3 pb-4 border-b border-border">
            <div className="relative w-24 h-24 rounded-full border-2 border-primary bg-surfaceDark overflow-hidden flex items-center justify-center shadow-lg shadow-amber-500/10">
              {imagePreview ? (
                <img src={imagePreview} alt="Child Preview" className="w-full h-full object-cover" />
              ) : (
                <User size={36} className="text-textMuted" />
              )}
            </div>
            <div>
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                onChange={handleFileChange}
                className="hidden"
              />
              <Button
                type="button"
                variant="outline"
                size="sm"
                onClick={() => fileInputRef.current?.click()}
                icon={<Camera size={14} />}
              >
                {imagePreview ? "Change Photo" : "Upload Child Photo"}
              </Button>
            </div>
          </div>

          <div className="space-y-4">
            <Input
              label="Full Name"
              placeholder="e.g. Leo Morgan"
              value={name}
              onChange={(e) => setName(e.target.value)}
              icon={<User size={18} />}
              required
            />

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input
                label="Age"
                type="number"
                placeholder="e.g. 8"
                value={age}
                onChange={(e) => setAge(e.target.value)}
                min="1"
                max="18"
                required
              />

              <div className="space-y-1.5 text-left">
                <label className="block text-xs font-black tracking-wider text-primary uppercase">
                  Gender
                </label>
                <div className="relative">
                  <select
                    value={gender}
                    onChange={(e) => setGender(e.target.value)}
                    className="w-full bg-surfaceDark text-white border border-border rounded-2xl px-4 py-3.5 text-sm appearance-none focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 cursor-pointer"
                    required
                  >
                    <option value="" disabled className="bg-surfaceDark text-textMuted">
                      Select Gender
                    </option>
                    <option value="Male" className="bg-surfaceDark text-white">
                      Male
                    </option>
                    <option value="Female" className="bg-surfaceDark text-white">
                      Female
                    </option>
                    <option value="Others" className="bg-surfaceDark text-white">
                      Others
                    </option>
                  </select>
                  <ChevronDown
                    size={16}
                    className="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-textMuted"
                  />
                </div>
              </div>
            </div>

            <Input
              label="Email Address (Optional)"
              type="email"
              placeholder="child@domain.com (optional)"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              icon={<Mail size={18} />}
            />

            <Input
              label="Phone Number (Optional)"
              type="tel"
              placeholder="+1 (555) 000-0000"
              value={phone}
              onChange={(e) => setPhone(e.target.value)}
              icon={<Phone size={18} />}
            />
          </div>

          <div className="pt-4 border-t border-border flex items-center justify-end gap-3">
            <Button
              type="button"
              variant="secondary"
              size="md"
              onClick={() => navigate("/profile")}
            >
              Cancel
            </Button>
            <Button
              type="submit"
              variant="primary"
              size="md"
              loading={uploading}
              icon={<UserPlus size={16} />}
              className="px-8 font-black"
            >
              Add Child Profile
            </Button>
          </div>
        </form>
      </Card>
    </div>
  );
};

export default AddChildPage;
</file>

