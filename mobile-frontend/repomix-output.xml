import React, { useEffect, useMemo, useState } from "react";
import {
    View,
    Text,
    StyleSheet,
    ScrollView,
    Image,
    TouchableOpacity,
    Alert,
    ActivityIndicator
} from "react-native";
import { useLocalSearchParams } from "expo-router";
import { supabase } from "@/lib/supabase";
import { COLORS } from "@/constants/colors";
import {
    getRecommendedHairstyles,
    HairstyleRecommendation
} from "@/constants/hairstyleRecommendations";

export default function TryOn() {
    const params = useLocalSearchParams();

    const scanId = useMemo(() => {
        const value = params.scanId;

        if (Array.isArray(value)) {
            return value[0] || "";
        }

        return String(value || "");
    }, [params.scanId]);

    const [scan, setScan] = useState<any>(null);
    const [metrics, setMetrics] = useState<any>(null);
    const [loading, setLoading] = useState(true);
    const [selectedHairstyle, setSelectedHairstyle] =
        useState<HairstyleRecommendation | null>(null);

    useEffect(() => {
        if (scanId) {
            loadTryOnData();
        }
        else {
            setLoading(false);
        }
    }, [scanId]);

    const loadTryOnData = async () => {
        try {
            setLoading(true);

            console.log(
                "TRYON RECEIVED SCAN ID:",
                scanId
            );

            if (!scanId) {
                throw new Error(
                    "Try-On scan ID missing"
                );
            }

            const {
                data: scanData,
                error: scanError
            } =
                await supabase
                    .from("face_scans")
                    .select("*")
                    .eq(
                        "id",
                        scanId
                    )
                    .maybeSingle();

            if (scanError) {
                throw scanError;
            }

            if (!scanData) {
                throw new Error(
                    "Face scan data not found"
                );
            }

            const {
                data: metricData,
                error: metricError
            } =
                await supabase
                    .from("face_metrics")
                    .select("*")
                    .eq(
                        "scan_id",
                        scanId
                    )
                    .maybeSingle();

            if (metricError) {
                throw metricError;
            }

            if (!metricData) {
                throw new Error(
                    "Face metrics data not found"
                );
            }

            console.log(
                "TRYON SCAN DATA:",
                scanData
            );

            console.log(
                "TRYON METRICS DATA:",
                metricData
            );

            setScan(scanData);
            setMetrics(metricData);
        }
        catch (error: any) {
            console.log(
                "TRYON LOAD ERROR:",
                error?.message || error
            );

            Alert.alert(
                "Error",
                error?.message ||
                "Unable to load Try-On data"
            );
        }
        finally {
            setLoading(false);
        }
    };

    const recommendedHairstyles =
        useMemo(() => {
            if (!scan?.face_shape) {
                return [];
            }

            return getRecommendedHairstyles(
                scan.face_shape
            );
        }, [scan?.face_shape]);

    const handleTryOn = (
        hairstyle: HairstyleRecommendation
    ) => {
        setSelectedHairstyle(hairstyle);

        console.log(
            "SELECTED HAIRSTYLE:",
            hairstyle.id
        );
    };

    const formatValue = (
        value: any,
        suffix = ""
    ) => {
        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return "--";
        }

        return `${value}${suffix}`;
    };

    if (loading) {
        return (
            <View style={styles.loading}>
                <ActivityIndicator
                    size="large"
                    color={COLORS.primary}
                />

                <Text style={styles.loadingText}>
                    Loading Recommendations...
                </Text>
            </View>
        );
    }

    if (!scanId) {
        return (
            <View style={styles.emptyContainer}>
                <Text style={styles.emptyTitle}>
                    FACE SCAN REQUIRED
                </Text>

                <Text style={styles.emptyText}>
                    Complete a face scan first to view
                    personalized hairstyle recommendations.
                </Text>
            </View>
        );
    }

    if (!scan || !metrics) {
        return (
            <View style={styles.emptyContainer}>
                <Text style={styles.emptyTitle}>
                    REPORT NOT AVAILABLE
                </Text>

                <Text style={styles.emptyText}>
                    We could not load the facial geometry
                    information for this scan.
                </Text>
            </View>
        );
    }

    return (
        <ScrollView
            style={styles.container}
            contentContainerStyle={
                styles.contentContainer
            }
            showsVerticalScrollIndicator={false}
        >
            <Text style={styles.header}>
                AI HAIRSTYLE TRY-ON
            </Text>

            <Text style={styles.subtitle}>
                Personalized using your facial geometry
            </Text>

            <View style={styles.scanCard}>
                <View style={styles.sectionHeader}>
                    <Text style={styles.sectionTitle}>
                        YOUR FACE SCAN
                    </Text>

                    <Text style={styles.sectionTag}>
                        3 ANGLES
                    </Text>
                </View>

                <View style={styles.imageRow}>
                    <ScanImage
                        uri={scan.front_image_url}
                        label="FRONT"
                    />

                    <ScanImage
                        uri={scan.left_image_url}
                        label="LEFT"
                    />

                    <ScanImage
                        uri={scan.right_image_url}
                        label="RIGHT"
                    />
                </View>
            </View>

            <View style={styles.analysisCard}>
                <View style={styles.sectionHeader}>
                    <Text style={styles.sectionTitle}>
                        FACE PROFILE
                    </Text>

                    <Text style={styles.sectionTag}>
                        AI ANALYSIS
                    </Text>
                </View>

                <View style={styles.metricsGrid}>
                    <ProfileMetric
                        title="Face Shape"
                        value={formatValue(
                            scan.face_shape
                        )}
                    />

                    <ProfileMetric
                        title="Symmetry"
                        value={formatValue(
                            metrics.face_symmetry
                        )}
                    />

                    <ProfileMetric
                        title="Face Ratio"
                        value={formatValue(
                            metrics.face_ratio
                        )}
                    />

                    <ProfileMetric
                        title="Jaw Shape"
                        value={formatValue(
                            metrics.jawline_shape
                        )}
                    />
                </View>
            </View>

            <View style={styles.recommendationHeader}>
                <Text style={styles.eyebrow}>
                    PERSONALIZED SELECTION
                </Text>

                <Text style={styles.recommendationTitle}>
                    TRY ON RECOMMENDED HAIRSTYLES
                </Text>

                <Text style={styles.recommendationText}>
                    These hairstyles are selected for your{" "}
                    <Text
                        style={
                            styles.highlightText
                        }
                    >
                        {scan.face_shape}
                    </Text>{" "}
                    face shape and facial geometry.
                </Text>
            </View>

            {recommendedHairstyles.length > 0 ? (
                <View style={styles.hairstyleGrid}>
                    {recommendedHairstyles.map(
                        (
                            hairstyle,
                            index
                        ) => {
                            const selected =
                                selectedHairstyle?.id ===
                                hairstyle.id;

                            return (
                                <View
                                    key={
                                        hairstyle.id
                                    }
                                    style={[
                                        styles.hairstyleCard,
                                        selected &&
                                        styles.hairstyleCardSelected
                                    ]}
                                >
                                    <View
                                        style={
                                            styles.hairstyleImageContainer
                                        }
                                    >
                                        <Image
                                            source={
                                                hairstyle.image
                                            }
                                            style={
                                                styles.hairstyleImage
                                            }
                                            resizeMode="cover"
                                        />

                                        <View
                                            style={
                                                styles.numberBadge
                                            }
                                        >
                                            <Text
                                                style={
                                                    styles.numberText
                                                }
                                            >
                                                {String(
                                                    index +
                                                    1
                                                ).padStart(
                                                    2,
                                                    "0"
                                                )}
                                            </Text>
                                        </View>

                                        {selected && (
                                            <View
                                                style={
                                                    styles.selectedBadge
                                                }
                                            >
                                                <Text
                                                    style={
                                                        styles.selectedBadgeText
                                                    }
                                                >
                                                    SELECTED
                                                </Text>
                                            </View>
                                        )}
                                    </View>

                                    <View
                                        style={
