import React, { useEffect, useState } from "react";

import {
    View,
    Text,
    StyleSheet,
    ScrollView,
    TouchableOpacity
} from "react-native";

import {
    useLocalSearchParams,
    useRouter
} from "expo-router";

import { COLORS } from "@/constants/colors";
import { supabase } from "@/lib/supabase";


export default function FaceResult() {

    const router = useRouter();

    const params = useLocalSearchParams();

    const [result, setResult] = useState<any>({});
    const [images, setImages] = useState<any>({});
    const [loading, setLoading] = useState(true);


    useEffect(() => {

        if (params.scanId) {

            loadScan();

        }

    }, [params.scanId]);


    const loadScan = async () => {

        try {

            const scanId =
                String(params.scanId || "");


            console.log(
                "FACE RESULT RECEIVED SCAN ID:",
                scanId
            );


            if (!scanId) {

                throw new Error(
                    "Scan ID missing"
                );

            }


            const {
                data: scan,
                error: scanError
            }
                =
                await supabase
                    .from("face_scans")
                    .select("*")
                    .eq(
                        "id",
                        scanId
                    )
                    .maybeSingle();


            if (scanError) {

                throw scanError;

            }


            if (!scan) {

                throw new Error(
                    "Face scan not found: " + scanId
                );

            }


            const {
                data: metrics,
                error: metricError
            }
                =
                await supabase
                    .from("face_metrics")
                    .select("*")
                    .eq(
                        "scan_id",
                        scanId
                    )
                    .maybeSingle();


            if (metricError) {

                throw metricError;

            }


            if (!metrics) {

                throw new Error(
                    "Face metrics not found"
                );

            }


            const formatted = {

                faceShape:
                    scan.face_shape || "Analyzed",

                aiAccuracy:
                    scan.ai_accuracy || 0,

                faceLength:
                    metrics.face_length ?? "--",

                faceWidth:
                    metrics.face_width ?? "--",

                faceRatio:
                    metrics.face_ratio ?? "--",

                foreheadWidth:
                    metrics.forehead_width ?? "--",

                foreheadHeight:
                    metrics.forehead_height ?? "--",

                cheekboneWidth:
                    metrics.cheekbone_width ?? "--",

                jawWidth:
                    metrics.jaw_width ?? "--",

                jawAngle:
                    metrics.jaw_angle ?? "--",

                jawlineShape:
                    metrics.jawline_shape ?? "--",

                faceSymmetry:
                    metrics.face_symmetry ?? "--",

                scanId:
                    scan.id

            };


            const scanImages = {

                front:
                    scan.front_image_url,

                left:
                    scan.left_image_url,

                right:
                    scan.right_image_url

            };


            console.log(
                "FACE RESULT DATA:",
                formatted
            );


            setResult(formatted);

            setImages(scanImages);

        }
        catch (error: any) {

            console.log(
                "FACE RESULT LOAD ERROR:",
                error.message || error
            );

        }
        finally {

            setLoading(false);

        }

    };


    const openGeometry = () => {

        const scanId =
            String(
                result.scanId ||
                params.scanId ||
                ""
            );


        console.log(
            "OPEN GEOMETRY SCAN ID:",
            scanId
        );


        if (!scanId) {

            console.log(
                "Missing scan ID for geometry"
            );

            return;

        }


        router.push({

            pathname: "/geometry",

            params: {
                scanId
            }

        });

    };


    if (loading) {

        return (

            <View style={styles.loadingContainer}>

                <View style={styles.loadingBadge}>
                    <Text style={styles.loadingBadgeText}>
                        AI
                    </Text>
                </View>

                <Text style={styles.loadingText}>
                    Analysing Face Data...
                </Text>

                <Text style={styles.loadingSubText}>
                    Processing facial geometry and proportions
                </Text>

            </View>

        );

    }


    return (

        <ScrollView
            style={styles.container}
            contentContainerStyle={styles.contentContainer}
            showsVerticalScrollIndicator={false}
        >

            <View style={styles.headerSection}>

                <View style={styles.headerBadge}>

                    <View style={styles.headerBadgeDot} />

                    <Text style={styles.headerBadgeText}>
                        AI ANALYSIS COMPLETE
                    </Text>

                </View>


                <Text style={styles.header}>
                    FACE ANALYSIS RESULT
                </Text>


                <Text style={styles.subtitle}>
                    AI Powered Facial Geometry Analysis
                </Text>

            </View>


            <View style={styles.mainCard}>

                <View style={styles.cardTopRow}>

                    <Text style={styles.label}>
                        DETECTED FACE SHAPE
                    </Text>

                    <View style={styles.analysisBadge}>
                        <Text style={styles.analysisBadgeText}>
                            ANALYZED
                        </Text>
                    </View>

                </View>


                <Text style={styles.shape}>
                    {result.faceShape}
                </Text>


                <Text style={styles.shapeDescription}>
                    Facial geometry profile
                </Text>


                <View style={styles.divider} />


                <View style={styles.accuracyCard}>

                    <View>

                        <Text style={styles.accuracyLabel}>
                            AI ACCURACY
                        </Text>

                        <Text style={styles.accuracyDescription}>
                            Analysis confidence
                        </Text>

                    </View>


                    <View style={styles.accuracyValueContainer}>

                        <Text style={styles.accuracyValue}>
                            {result.aiAccuracy}%
                        </Text>

                    </View>

                </View>

            </View>


            <View style={styles.metricsCard}>

                <View style={styles.sectionHeader}>

                    <View>

                        <Text style={styles.sectionEyebrow}>
                            FACIAL PROFILE
                        </Text>

                        <Text style={styles.sectionTitle}>
                            QUICK ANALYSIS
                        </Text>

                    </View>


                    <View style={styles.metricCountBadge}>

                        <Text style={styles.metricCountText}>
                            5 METRICS
                        </Text>

                    </View>

                </View>


                <View style={styles.metricsContainer}>

                    <Metric
                        title="Face Ratio"
                        value={result.faceRatio}
                    />


                    <Metric
                        title="Face Length"
                        value={result.faceLength}
                    />


                    <Metric
                        title="Face Width"
                        value={result.faceWidth}
                    />


                    <Metric
                        title="Jaw Shape"
                        value={result.jawlineShape}
                    />


                    <Metric
                        title="Symmetry"
                        value={result.faceSymmetry}
                    />

                </View>

            </View>


            <View style={styles.geometryInfo}>

                <View style={styles.geometryIcon}>

                    <Text style={styles.geometryIconText}>
                        G
                    </Text>

                </View>


                <View style={styles.geometryTextContainer}>

                    <Text style={styles.geometryTitle}>
                        Complete Geometry Report
                    </Text>

                    <Text style={styles.geometryDescription}>
                        Explore detailed facial measurements and proportions
                    </Text>

                </View>

            </View>


            <TouchableOpacity
                style={styles.button}
                onPress={openGeometry}
                activeOpacity={0.86}
            >

                <Text style={styles.buttonText}>
                    VIEW COMPLETE GEOMETRY
                </Text>

                <Text style={styles.buttonArrow}>
                    ›
                </Text>

            </TouchableOpacity>


            <Text style={styles.footerText}>
                KSHURAK • AI FACIAL INTELLIGENCE
            </Text>

        </ScrollView>

    );

}


function Metric({
    title,
    value
}: {
    title: string,
